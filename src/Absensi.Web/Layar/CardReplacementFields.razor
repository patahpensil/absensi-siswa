<p class="field-help">Kartu aktif <strong class="mono">@OldUid</strong> akan dinonaktifkan setelah kartu pengganti berhasil disimpan.</p>
<label for="replacement-reason">Alasan penggantian</label>
<select id="replacement-reason" value="@Reason" @onchange="OnChanged" disabled="@Disabled">
    <option value="hilang">Hilang</option>
    <option value="rusak">Rusak</option>
</select>

@code {
    [Parameter, EditorRequired] public string OldUid { get; set; } = "";
    [Parameter] public string Reason { get; set; } = "hilang";
    [Parameter] public EventCallback<string> ReasonChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task OnChanged(ChangeEventArgs args) => ReasonChanged.InvokeAsync(args.Value?.ToString() ?? "hilang");
}
