@using Absensi.Web.Layanan
@using Microsoft.Data.Sqlite
@inject StatusAplikasi Status

@* PRD §3 P-21: used after a password reset (Forced) and from Pengaturan.
   LayananAkun.ChangeOwnPassword checks the current password and the rules. *@
<form class="password-change" id="password-change" @onsubmit="Submit" @onsubmit:preventDefault>
    @if (Forced)
    {
        <p id="password-change-required" class="message">Sandi akun ini baru saja diatur ulang oleh Kepala Sekolah atau Admin. Buat sandi baru sebelum melanjutkan.</p>
    }
    <label for="password-current">Sandi saat ini</label>
    <input id="password-current" type="password" autocomplete="current-password" @bind="current" disabled="@busy" />
    <label for="password-new">Sandi baru</label>
    <input id="password-new" type="password" autocomplete="new-password" minlength="8" @bind="next" disabled="@busy" />
    <label for="password-confirm">Ulangi sandi baru</label>
    <input id="password-confirm" type="password" autocomplete="new-password" minlength="8" @bind="confirm" disabled="@busy" />
    <p class="field-help">Minimal 8 karakter dan berbeda dari sandi saat ini.</p>
    @if (message is not null)
    {
        <p id="password-change-message" class="message @(ok ? "positive" : "danger")" role="@(ok ? "status" : "alert")">@message</p>
    }
    <div class="button-row">
        <button id="password-change-save" type="submit" class="primary" disabled="@busy">Simpan sandi baru</button>
        @if (Forced)
        {
            <button id="password-change-logout" type="button" disabled="@busy" @onclick="OnLogout">Keluar</button>
        }
    </div>
</form>

@code {
    [Parameter] public bool Forced { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }

    private string current = "", next = "", confirm = "";
    private string? message;
    private bool busy, ok;

    private async Task Submit()
    {
        if (busy) return;
        if (next != confirm)
        {
            (ok, message) = (false, "Ulangi sandi baru tidak sama.");
            return;
        }

        busy = true;
        message = null;
        try
        {
            await Status.ChangeOwnPasswordAsync(current, next);
            ok = !Status.StorageFailed;
            message = ok ? "Sandi baru tersimpan." : Status.CatatanPenyimpanan;
            current = next = confirm = "";
            if (ok) await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException ex) { (ok, message) = (false, ex.Message); }
        catch (SqliteException) { (ok, message) = (false, "Sandi belum dapat disimpan. Coba kembali."); }
        finally { busy = false; }
    }
}
