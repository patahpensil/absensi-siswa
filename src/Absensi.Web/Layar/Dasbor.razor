@using Absensi.Data.Repositori
@using Absensi.Domain.Kehadiran
@using Absensi.Web.Layanan
@inject StatusAplikasi Status

<div class="page-heading"><div><h1>Pusat kendali kehadiran</h1><p>Pantau kedatangan, siswa yang perlu ditindaklanjuti, dan kesiapan data.</p></div><div class="gate-dashboard-actions">@if (WorkspaceView.CanManage(Status)) { <button class="secondary" id="dashboard-open-tv" @onclick='() => OnNavigate.InvokeAsync("Layar gerbang")'>Layar gerbang TV</button> }<button class="primary" id="dashboard-open-gate" @onclick='() => OnNavigate.InvokeAsync("Absensi")'><UiIcon Name="card" /> Buka absensi <kbd>F2</kbd></button></div></div>
<AttendanceSummary Rows="rows" Students="students.Count(s => s.Aktif)" DateLabel='@Status.Jam.Sekarang.ToString("dd / MM / yyyy")' />
<div class="terminal-grid">
    <div class="main-column">
        <section class="panel">
            <header class="panel-header"><h2><UiIcon Name="grid" /> Pantauan kedatangan</h2></header>
            <div class="gate-banner"><div><strong>Aktivitas kedatangan hari ini</strong><small>Hasil dari catatan absensi yang tersimpan</small></div><span class="badge neutral">@rows.Count(r => r.JamMasuk is not null) sudah tap</span></div>
            @if (latest.Count == 0)
            {
                <div class="gate-empty"><span class="empty-icon"><UiIcon Name="card" /></span><h3>Menunggu tap pertama</h3><p>Identitas dan hasil tap akan tampil setelah pembacaan kartu tercatat.</p><button class="text-button" @onclick='() => OnNavigate.InvokeAsync("Absensi")'>Buka layar absensi <UiIcon Name="arrow" /></button></div>
            }
            else
            {
                <div class="tap-cards">
                    @foreach (var row in latest)
                    {
                        <article class="tap-card @WorkspaceView.Tone(row.Status)"><div class="tap-card-top"><span>Siswa</span><span>@row.NamaKelas</span></div><span class="identity-photo">@WorkspaceView.Initials(row.NamaSiswa)</span><h3>@row.NamaSiswa</h3><span class="badge @WorkspaceView.Tone(row.Status)">@row.Status</span><time class="mono">@WorkspaceView.Time(row.JamMasuk)</time></article>
                    }
                </div>
            }
            <div class="panel-footer"><span>Identitas foto belum tersedia pada data contoh.</span><button class="text-button" @onclick='() => OnNavigate.InvokeAsync("Absensi")'>Lihat absensi <UiIcon Name="arrow" /></button></div>
        </section>
        <section class="panel">
            <header class="panel-header"><h2><UiIcon Name="people" /> Tindak lanjut siswa</h2></header>
            <div class="panel-toolbar"><div class="segmented"><button id="watch-not-tapped" class="@(!showExcused ? "selected" : "")" @onclick="() => showExcused = false">Belum tap <b>@rows.Count(r => r.Status == StatusAbsensiSiswa.Alpa)</b></button><button id="watch-excused" class="@(showExcused ? "selected" : "")" @onclick="() => showExcused = true">Izin / Sakit <b>@rows.Count(r => r.Status is StatusAbsensiSiswa.Izin or StatusAbsensiSiswa.Sakit)</b></button></div><span class="muted">@WatchRows().Count() siswa</span></div>
            <div class="table-wrap"><table id="dashboard-watchlist"><thead><tr><th>Siswa</th><th>NISN</th><th>Kelas</th><th>Status</th></tr></thead><tbody>
                @foreach (var row in WatchRows().Take(8))
                { <tr><td class="name-cell"><span class="mini-avatar">@WorkspaceView.Initials(row.NamaSiswa)</span>@row.NamaSiswa</td><td class="mono muted">@students.FirstOrDefault(s => s.Id == row.SiswaId)?.Nisn</td><td>@row.NamaKelas</td><td><span class="badge @WorkspaceView.Tone(row.Status)">@row.Status</span></td></tr> }
            </tbody></table></div>
            @if (!WatchRows().Any()) { <div class="empty-state compact">Tidak ada siswa pada kategori ini.</div> }
            <div class="panel-footer"><span>Menampilkan maksimal 8 siswa.</span><button class="text-button" @onclick='() => OnNavigate.InvokeAsync("Absensi")'>Buka seluruh daftar <UiIcon Name="arrow" /></button></div>
        </section>
    </div>
    <aside class="side-column">
        <SchedulePanel />
        <section class="panel"><header class="panel-header"><h2>Kesiapan data</h2></header><div class="readiness-list"><div><span>Belum memiliki kartu</span><strong class="mono">@students.Count(s => s.Aktif && !s.PunyaKartu)</strong></div><div><span>Belum memiliki foto</span><strong class="mono">@students.Count(s => s.Aktif && !s.PunyaFoto)</strong></div><div><span>Orang tua belum tertaut</span><strong class="mono">@students.Count(s => s.Aktif && !s.TertautTelegram)</strong></div><div><span>Kelas dalam lingkup akun</span><strong class="mono">@WorkspaceView.Classes(Status).Count</strong></div></div><div class="panel-footer"><button class="text-button" @onclick='() => OnNavigate.InvokeAsync("Siswa")'>Periksa data siswa <UiIcon Name="arrow" /></button></div></section>
        <section class="info-panel"><h3>Lingkungan uji</h3><p>Data tersimpan di browser ini. Pesan ke orang tua tidak dikirim; antreannya dapat dilihat di menu Notifikasi.</p></section>
    </aside>
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
    private IReadOnlyList<SiswaDaftar> students = Array.Empty<SiswaDaftar>();
    private IReadOnlyList<AbsensiSiswaUntukNotifikasi> rows = Array.Empty<AbsensiSiswaUntukNotifikasi>();
    private List<AbsensiSiswaUntukNotifikasi> latest = new();
    private bool showExcused;
    protected override void OnInitialized()
    {
        students = WorkspaceView.Students(Status);
        rows = WorkspaceView.Attendance(Status);
        latest = rows.Where(r => r.JamMasuk is not null).OrderByDescending(r => r.JamMasuk).Take(4).ToList();
    }
    private IEnumerable<AbsensiSiswaUntukNotifikasi> WatchRows() => rows.Where(r => showExcused ? r.Status is StatusAbsensiSiswa.Izin or StatusAbsensiSiswa.Sakit : r.Status == StatusAbsensiSiswa.Alpa);
}

