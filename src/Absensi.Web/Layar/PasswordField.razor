@* Password input with a show/hide toggle (ASVS 5.0 6.2.6 allows temporarily
   viewing the whole masked password). The input id stays the one the caller
   gives, so labels and tests keep working. *@
<div class="password-field">
    <input id="@Id" type="@(visible ? "text" : "password")" value="@Value" @oninput="OnInputAsync"
           autocomplete="@AutoComplete" required="@Required" minlength="@MinLength" disabled="@Disabled"
           spellcheck="false" autocapitalize="off" />
    <button id="@(Id + "-toggle")" type="button" class="password-toggle" disabled="@Disabled"
            aria-controls="@Id" aria-pressed="@(visible ? "true" : "false")"
            aria-label="@(visible ? "Sembunyikan sandi" : "Tampilkan sandi")"
            title="@(visible ? "Sembunyikan sandi" : "Tampilkan sandi")" @onclick="Toggle">
        <UiIcon Name="@(visible ? "eye-off" : "eye")" />
    </button>
</div>

@code {
    private bool visible;

    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string AutoComplete { get; set; } = "current-password";
    [Parameter] public bool Required { get; set; }
    [Parameter] public int? MinLength { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private void Toggle() => visible = !visible;
}
