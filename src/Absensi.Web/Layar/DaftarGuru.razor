@using Absensi.Data.Kartu
@using Absensi.Data.Repositori
@using Absensi.Domain.Kehadiran
@using Absensi.Web.Layanan
@inject StatusAplikasi Status

<div class="page-heading">
    <div><h1>Data guru</h1><p>Identitas guru dan kartu pegawai.</p></div>
    <span class="page-total"><strong class="mono">@teachers.Count</strong> guru</span>
</div>
@if (!WorkspaceView.CanManage(Status))
{
    <p class="notice">Akun wali kelas tidak memiliki kewenangan mengakses master guru.</p>
}
else
{
    <section class="panel">
        <header class="panel-header"><h2><UiIcon Name="people" /> Daftar guru</h2></header>
        <div class="panel-toolbar">
            <div class="search-field"><UiIcon Name="search" /><input id="teacher-search" aria-label="Cari nama atau NIP guru" placeholder="Cari nama atau NIP…" @bind="query" @bind:event="oninput" /></div>
            <button type="button" class="primary" id="teacher-add" @onclick="() => addOpen = true">Tambah guru</button>
            <button type="button" id="teacher-import-excel" @onclick="() => importOpen = true">Impor Excel</button>
            <span class="muted">@teachers.Count(g => g.Aktif) aktif · @teachers.Count(g => g.Aktif && !g.PunyaKartu) belum punya kartu</span>
        </div>
        <div class="table-wrap">
            <table id="tabel-guru">
                <thead><tr><th>Guru</th><th>NIP</th><th>Jabatan</th><th>Kartu RFID</th><th>Status</th><th>Tindakan</th></tr></thead>
                <tbody>
                    @foreach (var teacher in Filtered())
                    {
                        <tr>
                            <td class="name-cell">
                                <button type="button" class="name-link" id="teacher-detail-@teacher.Id" title="Lihat detail dan riwayat absensi" @onclick="() => detailId = teacher.Id">
                                    @if (Status.PhotoUrl($"{teacher.Nip}.png") is { } photo) { <img class="mini-avatar" src="@photo" alt="" /> }
                                    else { <span class="mini-avatar">@WorkspaceView.Initials(teacher.Nama)</span> }
                                    @teacher.Nama
                                </button>
                            </td>
                            <td class="mono muted">@teacher.Nip</td><td>@teacher.Jabatan</td>
                            <td class="mono">@(teacher.KartuUid ?? "Belum terdaftar")</td>
                            <td><span class="badge @(teacher.Aktif ? "positive" : "neutral")">@(teacher.Aktif ? "Aktif" : teacher.AlasanNonaktif ?? "Tidak aktif")</span></td>
                            <td><div class="master-row-actions">
                                <button type="button" class="text-button" id="edit-teacher-@teacher.Id" @onclick="() => editId = teacher.Id">Ubah</button>
                                @if (teacher.Aktif && !teacher.PunyaKartu)
                                {
                                    <button type="button" class="text-button" id="register-teacher-card-@teacher.Id" @onclick="() => OpenRegistration(teacher)">Daftarkan kartu</button>
                                }
                                else if (teacher.Aktif)
                                {
                                    <button type="button" class="text-button" id="replace-teacher-card-@teacher.Id" @onclick="() => OpenRegistration(teacher)">Ganti kartu</button>
                                }
                                @if (teacher.Aktif)
                                {
                                    <button type="button" class="text-button" id="deactivate-teacher-@teacher.Id" @onclick="() => mutation = teacher">Nonaktifkan</button>
                                }
                            </div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Filtered().Any()) { <div class="empty-state">Tidak ada guru yang cocok dengan pencarian.</div> }
        <div class="panel-footer">Pilih guru, tap kartu, lalu konfirmasi Simpan kartu. Nomor kartu harus unik untuk seluruh siswa dan guru.</div>
    </section>
    <TeacherAttendance />
}
@if (detailId is { } openTeacherId)
{
    <PersonDetailPanel Kind="PersonKind.Teacher" Id="openTeacherId" OnClose="CloseDetail" />
}
@if (selectedTeacher is not null && WorkspaceView.CanManage(Status))
{
    <div class="modal-backdrop" @onkeydown="HandleDialogKey">
        <section class="dialog panel" role="dialog" aria-modal="true" aria-labelledby="teacher-registration-title">
            <header class="panel-header">
                <h2 id="teacher-registration-title">@(selectedTeacher.PunyaKartu ? "Ganti kartu guru" : "Registrasi kartu guru")</h2>
                <button type="button" class="icon-button" aria-label="Tutup registrasi guru" disabled="@saving" @onclick="CloseRegistration">×</button>
            </header>
            <div class="dialog-body">
                <p class="eyebrow">Guru terpilih</p><h3>@selectedTeacher.Nama</h3><p class="mono muted">NIP @selectedTeacher.Nip</p>
                <p>Tap kartu pada reader, periksa nomor dan identitas guru, lalu simpan. Pembacaan di formulir ini tidak dicatat sebagai absensi.</p>
                <form @onsubmit:preventDefault>
                    @if (selectedTeacher.PunyaKartu)
                    {
                        <CardReplacementFields OldUid="@(selectedTeacher.KartuUid ?? string.Empty)" @bind-Reason="replacementReason" Disabled="@(saving || registrationComplete)" />
                    }
                    <label for="teacher-registration-uid">Nomor RFID</label>
                    <input id="teacher-registration-uid" @ref="cardInput" maxlength="64" @bind="pendingUid" @bind:event="oninput" autocomplete="off" disabled="@(registrationComplete || saving)" aria-describedby="teacher-registration-help" />
                    <p id="teacher-registration-help" class="field-help">Nol di depan dipertahankan. Kartu baru ditautkan setelah Simpan kartu ditekan.</p>
                    @if (registrationError is not null) { <p id="teacher-registration-error" class="message danger" role="alert">@registrationError</p> }
                    @if (registrationComplete && !Status.StorageFailed) { <p id="teacher-registration-success" class="message positive" role="status">Kartu @pendingUid ditautkan dan sudah diverifikasi untuk @selectedTeacher.Nama.</p> }
                    @if (Status.StorageFailed) { <p class="message danger" role="alert">@Status.CatatanPenyimpanan</p> }
                    <div class="dialog-actions">
                        <button type="button" @onclick="CloseRegistration" disabled="@saving">Tutup</button>
                        <button id="save-teacher-registration" type="button" @onclick="RegisterCard" class="primary" disabled="@(registrationComplete || saving || string.IsNullOrWhiteSpace(pendingUid))">@(saving ? "Menyimpan…" : "Simpan kartu")</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
}

@if ((addOpen || editId is not null) && WorkspaceView.CanManage(Status))
{
    <MasterPersonEditor Kind="PersonKind.Teacher" Id="editId" OnClose="CloseEditor" OnSaved="Reload" />
}
@if (mutation is not null && WorkspaceView.CanManage(Status))
{
    <MutationDialog Kind="PersonKind.Teacher" Id="mutation.Id" Name="@mutation.Nama" OnClose="() => mutation = null" OnSaved="Reload" />
}
@if (importOpen && WorkspaceView.CanManage(Status))
{
    <MasterImportDialog Kind="PersonKind.Teacher" OnClose="CloseImport" OnSaved="Reload" />
}

@code {
    private int? editId;
    private GuruDaftar? mutation;
    private bool importOpen;
    private bool addOpen;
    private void CloseEditor() { editId = null; addOpen = false; }
    private void CloseImport() => importOpen = false;

    private int? detailId;
    private string query = "";
    private IReadOnlyList<GuruDaftar> teachers = Array.Empty<GuruDaftar>();
    private GuruDaftar? selectedTeacher;
    private string pendingUid = "";
    private string replacementReason = "hilang";
    private string? registrationError;
    private bool registrationComplete, saving, focusCard;
    private ElementReference cardInput;
    private readonly LayananRegistrasiKartu cards = new();

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        teachers = WorkspaceView.CanManage(Status)
            ? new RepositoriGuru().DaftarLengkap(Status.Koneksi!)
            : Array.Empty<GuruDaftar>();
    }

    private IEnumerable<GuruDaftar> Filtered() => teachers.Where(g =>
        g.Nama.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase) ||
        g.Nip.Contains(query.Trim(), StringComparison.Ordinal));

    private void CloseDetail() { detailId = null; Reload(); }

    private void OpenRegistration(GuruDaftar teacher)
    {
        if (!WorkspaceView.CanManage(Status) || !teacher.Aktif) return;
        selectedTeacher = teacher;
        replacementReason = "hilang";
        pendingUid = "";
        registrationError = null;
        registrationComplete = false;
        focusCard = true;
    }

    private void CloseRegistration()
    {
        if (saving) return;
        selectedTeacher = null;
        pendingUid = "";
        registrationError = null;
        registrationComplete = false;
        focusCard = false;
    }

    private void HandleDialogKey(KeyboardEventArgs e) { if (e.Key == "Escape") CloseRegistration(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusCard && selectedTeacher is not null)
        {
            focusCard = false;
            await cardInput.FocusAsync();
        }
    }

    private async Task RegisterCard()
    {
        if (saving || registrationComplete || selectedTeacher is null || !WorkspaceView.CanManage(Status) || string.IsNullOrWhiteSpace(pendingUid)) return;
        saving = true;
        registrationError = null;
        try
        {
            pendingUid = pendingUid.Trim();
            if (selectedTeacher.PunyaKartu)
                cards.GantiKartuHilang(Status.Koneksi!, Status.Akun!, Status.Jam.Sekarang, JenisPemilikKartu.Guru,
                    selectedTeacher.Id, pendingUid, replacementReason, selectedTeacher.KartuUid);
            else
                cards.RegisterTeacherCard(Status.Koneksi!, Status.Akun!, Status.Jam.Sekarang, pendingUid, selectedTeacher.Id);
            var storedUid = new RepositoriKartu().CariUidAktifUntukPemilik(Status.Koneksi!, JenisPemilikKartu.Guru, selectedTeacher.Id);
            if (storedUid != pendingUid) throw new InvalidOperationException("Pasangan guru dan kartu belum dapat diverifikasi. Muat ulang daftar guru.");
            registrationComplete = true;
            await Status.SimpanAsync();
            Reload();
        }
        catch (InvalidOperationException ex) { registrationError = ex.Message; }
        catch (Microsoft.Data.Sqlite.SqliteException) { registrationError = "Kartu belum dapat disimpan. Periksa daftar guru lalu coba kembali."; }
        finally { saving = false; }
    }
}
