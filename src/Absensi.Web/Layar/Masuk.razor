@using Absensi.Data.Lisensi
@using Absensi.Web.Layanan
@inject StatusAplikasi Status
<main class="login-layout">
    <section class="login-story"><div class="brand"><span class="brand-mark"><UiIcon Name="school" /></span><strong>Absensi<span> / SMP</span></strong></div><div><p class="eyebrow">RUANG KERJA SEKOLAH</p><h2>Setiap kedatangan.<br />Tercatat dengan jelas.</h2><p>Pantau kehadiran siswa dan guru dalam satu ruang kerja yang teratur.</p><div class="login-timeline"><span><b class="mono">07.30</b>Batas hadir</span><span><b class="mono">08.00</b>Daftar wali</span><span><b class="mono">08.10</b>Rekap orang tua</span></div></div><small>Versi pengembangan · gunakan data sintetis saja</small></section>
    <section class="login-form-area"><div class="login-card"><span class="environment-tag"><span class="dot"></span> Lingkungan uji</span>@if (Status.PhotoUrl(Status.LogoName) is { } logo) { <img id="login-logo" class="login-logo" src="@logo" alt="Logo sekolah" /> }<h1 id="nama-sekolah">@Status.NamaSekolah</h1><p class="muted">Masuk ke ruang kerja · Tahun ajaran @Status.TahunAjaran</p><p class="muted" id="status-lisensi">@licenseText</p><form @onsubmit="Submit" @onsubmit:preventDefault><label for="username">Username</label><input id="username" @bind="username" autocomplete="username" required /><label for="sandi">Sandi</label><input id="sandi" type="password" @bind="password" autocomplete="current-password" required />@if (error is not null) { <p class="message danger" id="galat-masuk" role="alert">@error</p> }<button id="tombol-masuk" type="submit" class="primary login-submit">Masuk <UiIcon Name="arrow" /></button></form>
    <div class="test-accounts"><p class="eyebrow">AKUN CONTOH</p><p class="muted">Pilih peran untuk mengisi formulir. Sandi: <code>contoh123</code></p>@foreach (var account in DataContoh.Akun) { <button type="button" id="isi-@account.Username" @onclick="() => Fill(account)"><span>@account.Peran<small class="mono">@account.Username</small></span><UiIcon Name="arrow" /></button> }<p class="field-help">Login ini untuk pengujian lokal browser. Identitas dan MFA produksi mengikuti PRD.</p></div></div></section>
</main>
@code {
    [Parameter] public EventCallback OnMasuk { get; set; }
    private string username = "", password = "";
    private string? error;
    // PANDUAN-UI-UX §9 Login: status lisensi, teks sama dengan LoginViewModel desktop.
    private string licenseText = "";
    protected override void OnInitialized() =>
        licenseText = Status.Koneksi is not null && new RepositoriLisensi().BacaStatus(Status.Koneksi) is { Aktif: true } ? "Lisensi: Aktif" : "Lisensi: (belum tersedia)";
    private void Fill(AkunContoh account) { username = account.Username; password = account.Sandi; error = null; }
    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrEmpty(password)) { error = "Username dan sandi wajib diisi."; return; }
        try
        {
            if (Status.Masuk(username, password) is null) { error = "Username atau sandi salah."; return; }
            error = null;
            await OnMasuk.InvokeAsync();
        }
        catch (Exception) { error = "Login belum dapat diproses. Muat ulang halaman lalu coba kembali."; }
    }
}
