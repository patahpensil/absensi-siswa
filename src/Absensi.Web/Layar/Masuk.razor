@using Absensi.Data.Lisensi
@using Absensi.Web.Layanan
@inject StatusAplikasi Status
<main class="login-layout">
    <section class="login-story"><div class="brand"><span class="brand-mark"><UiIcon Name="school" /></span><strong>Absensi siswa</strong></div><div><h2>Absensi RFID siswa dan guru</h2><p>@(Status.Mode.IsReal ? "Uji coba data asli. Data hanya tersimpan di browser perangkat ini; unduh cadangan secara rutin di Pengaturan." : "Lingkungan uji. Gunakan data sintetis saja; data tersimpan di browser ini.")</p></div></section>
    <section class="login-form-area"><div class="login-card"><span class="environment-tag"><span class="dot"></span> @Status.Mode.EnvironmentLabel</span>@if (Status.PhotoUrl(Status.LogoName) is { } logo) { <img id="login-logo" class="login-logo" src="@logo" alt="Logo sekolah" /> }<h1 id="nama-sekolah">@Status.NamaSekolah</h1><p class="muted">Masuk ke ruang kerja · Tahun ajaran @Status.TahunAjaran</p><p class="muted" id="status-lisensi">@licenseText</p><form @onsubmit="Submit" @onsubmit:preventDefault><label for="username">Username</label><input id="username" @bind="username" autocomplete="username" required /><label for="sandi">Sandi</label><PasswordField Id="sandi" @bind-Value="password" AutoComplete="current-password" Required="true" />@if (error is not null) { <p class="message danger" id="galat-masuk" role="alert">@error</p> }<button id="tombol-masuk" type="submit" class="primary login-submit">Masuk <UiIcon Name="arrow" /></button></form>
    @if (!Status.Mode.IsReal) { <div class="test-accounts"><p class="eyebrow">Akun contoh</p><p class="muted">Pilih peran untuk mengisi formulir. Sandi: <code>@DataContoh.SandiContoh</code></p>@foreach (var account in DataContoh.Akun) { <button type="button" id="isi-@account.Username" @onclick="() => Fill(account)"><span>@account.Peran<small class="mono">@account.Username</small></span><UiIcon Name="arrow" /></button> }<p class="field-help">Akun contoh hanya ada pada data contoh.</p></div> }</div></section>
</main>
@code {
    [Parameter] public EventCallback OnMasuk { get; set; }
    private string username = "", password = "";
    private string? error;
    // PANDUAN-UI-UX §9 Login: status lisensi, teks sama dengan LoginViewModel desktop.
    private string licenseText = "";
    protected override void OnInitialized() =>
        licenseText = Status.Koneksi is not null && new RepositoriLisensi().BacaStatus(Status.Koneksi) is { Aktif: true } ? "Lisensi: Aktif" : "Lisensi: (belum tersedia)";
    private void Fill(AkunContoh account) { username = account.Username; password = account.Sandi; error = null; }
    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrEmpty(password)) { error = "Username dan sandi wajib diisi."; return; }
        try
        {
            if (Status.Masuk(username, password) is null) { error = "Username atau sandi salah."; return; }
            error = null;
            await OnMasuk.InvokeAsync();
        }
        catch (Exception) { error = "Login belum dapat diproses. Muat ulang halaman lalu coba kembali."; }
    }
}
