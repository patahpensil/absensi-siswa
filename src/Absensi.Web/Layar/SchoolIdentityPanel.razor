@using Absensi.Data.Pengaturan
@using Absensi.Data.Repositori
@using Absensi.Web.Layanan
@using Microsoft.AspNetCore.Components.Forms
@inject StatusAplikasi Status

@* PANDUAN-UI-UX §9 Pengaturan: identitas sekolah. Validasi dan audit ada di
   SchoolIdentityService; layar ini hanya memanggilnya lalu membaca ulang. *@
<section class="panel" id="school-identity">
    <header class="panel-header"><h2><UiIcon Name="school" /> Identitas sekolah</h2><span class="panel-code">LAPORAN</span></header>
    <div class="settings-body">
        <p>Nama, NPSN dan alamat dipakai pada judul aplikasi dan kepala laporan.</p>
        <div class="logo-row">
            @if (Status.PhotoUrl(Status.LogoName) is { } logo) { <img id="school-logo-preview" class="school-logo" src="@logo" alt="Logo sekolah" /> }
            else { <span class="school-logo empty" id="school-logo-empty">Belum ada logo</span> }
            <label class="text-button photo-upload" for="school-logo-input">@(uploading ? "Mengunggah…" : Status.LogoName is null ? "Unggah logo" : "Ganti logo")</label>
            <InputFile id="school-logo-input" class="visually-hidden" accept="image/png,image/jpeg,image/webp" OnChange="UploadLogo" disabled="@uploading" />
        </div>
        @if (logoMessage is not null) { <p id="school-logo-message" class="message @(logoOk ? "positive" : "danger")" role="@(logoOk ? "status" : "alert")">@logoMessage</p> }
        <form @onsubmit="Save" @onsubmit:preventDefault>
            <fieldset class="master-fields single" disabled="@busy">
                <div>
                    <label for="school-name">Nama sekolah</label>
                    <input id="school-name" maxlength="120" @bind="name" />
                </div>
                <div>
                    <label for="school-npsn">NPSN</label>
                    <input id="school-npsn" inputmode="numeric" maxlength="8" @bind="npsn" />
                    <p class="field-help">8 angka. Boleh dikosongkan.</p>
                </div>
                <div>
                    <label for="school-address">Alamat</label>
                    <input id="school-address" maxlength="250" @bind="address" />
                </div>
            </fieldset>
            <button id="school-identity-save" type="submit" class="primary" disabled="@busy">Simpan identitas</button>
        </form>
        @if (message is not null) { <p id="school-identity-message" class="message @(ok ? "positive" : "danger")" role="@(ok ? "status" : "alert")">@message</p> }
    </div>
</section>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    private string name = "", npsn = "", address = "";
    private bool busy, ok, uploading, logoOk;
    private string? message, logoMessage;

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        uploading = true;
        logoMessage = null;
        try
        {
            using var buffer = new MemoryStream();
            try { await using (var stream = e.File.OpenReadStream(Status.MaxPhotoBytes)) { await stream.CopyToAsync(buffer); } }
            catch (IOException) { logoOk = false; logoMessage = "Berkas terlalu besar atau tidak dapat dibaca (maksimal 8 MB)."; return; }
            var error = await Status.UploadLogoAsync(buffer.ToArray());
            logoOk = error is null;
            logoMessage = error ?? "Logo sekolah tersimpan dan dipakai pada judul aplikasi serta laporan.";
            if (logoOk) await OnSaved.InvokeAsync();
        }
        finally { uploading = false; }
    }

    protected override void OnInitialized() => Load();

    private void Load()
    {
        var stored = new RepositoriSekolah().FindIdentity(Status.Koneksi!);
        name = stored?.Name ?? "";
        npsn = stored?.Npsn ?? "";
        address = stored?.Address ?? "";
    }

    private async Task Save()
    {
        busy = true;
        message = null;
        try
        {
            var wanted = new SchoolIdentity(name, npsn, address);
            new SchoolIdentityService().Update(Status.Koneksi!, Status.Akun!, Status.Jam.Sekarang, wanted);
            var stored = new RepositoriSekolah().FindIdentity(Status.Koneksi!);
            if (stored is null || stored.Name != name.Trim())
            {
                ok = false;
                message = "Identitas belum terbaca kembali dari data. Coba simpan lagi.";
                return;
            }

            await Status.SimpanAsync();
            Status.RefreshSchoolName();
            Load();
            ok = true;
            message = Status.StorageFailed
                ? "Identitas tersimpan di sesi ini, tetapi belum tersimpan ke browser."
                : $"Identitas sekolah tersimpan: {stored.Name}.";
            await OnSaved.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            ok = false;
            message = ex.Message;
        }
        finally { busy = false; }
    }
}
