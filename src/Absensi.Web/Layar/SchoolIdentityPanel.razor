@using Absensi.Data.Pengaturan
@using Absensi.Data.Repositori
@using Absensi.Web.Layanan
@inject StatusAplikasi Status

@* PANDUAN-UI-UX §9 Pengaturan: identitas sekolah. Validasi dan audit ada di
   SchoolIdentityService; layar ini hanya memanggilnya lalu membaca ulang. *@
<section class="panel" id="school-identity">
    <header class="panel-header"><h2><UiIcon Name="school" /> Identitas sekolah</h2><span class="panel-code">LAPORAN</span></header>
    <div class="settings-body">
        <p>Nama, NPSN dan alamat dipakai pada judul aplikasi dan kepala laporan.</p>
        <form @onsubmit="Save" @onsubmit:preventDefault>
            <fieldset class="master-fields single" disabled="@busy">
                <div>
                    <label for="school-name">Nama sekolah</label>
                    <input id="school-name" maxlength="120" @bind="name" />
                </div>
                <div>
                    <label for="school-npsn">NPSN</label>
                    <input id="school-npsn" inputmode="numeric" maxlength="8" @bind="npsn" />
                    <p class="field-help">8 angka. Boleh dikosongkan.</p>
                </div>
                <div>
                    <label for="school-address">Alamat</label>
                    <input id="school-address" maxlength="250" @bind="address" />
                </div>
            </fieldset>
            <button id="school-identity-save" type="submit" class="primary" disabled="@busy">Simpan identitas</button>
        </form>
        @if (message is not null) { <p id="school-identity-message" class="message @(ok ? "positive" : "danger")" role="@(ok ? "status" : "alert")">@message</p> }
    </div>
</section>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    private string name = "", npsn = "", address = "";
    private bool busy, ok;
    private string? message;

    protected override void OnInitialized() => Load();

    private void Load()
    {
        var stored = new RepositoriSekolah().FindIdentity(Status.Koneksi!);
        name = stored?.Name ?? "";
        npsn = stored?.Npsn ?? "";
        address = stored?.Address ?? "";
    }

    private async Task Save()
    {
        busy = true;
        message = null;
        try
        {
            var wanted = new SchoolIdentity(name, npsn, address);
            new SchoolIdentityService().Update(Status.Koneksi!, Status.Akun!, Status.Jam.Sekarang, wanted);
            var stored = new RepositoriSekolah().FindIdentity(Status.Koneksi!);
            if (stored is null || stored.Name != name.Trim())
            {
                ok = false;
                message = "Identitas belum terbaca kembali dari data. Coba simpan lagi.";
                return;
            }

            await Status.SimpanAsync();
            Status.RefreshSchoolName();
            Load();
            ok = true;
            message = Status.StorageFailed
                ? "Identitas tersimpan di sesi ini, tetapi belum tersimpan ke browser."
                : $"Identitas sekolah tersimpan: {stored.Name}.";
            await OnSaved.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            ok = false;
            message = ex.Message;
        }
        finally { busy = false; }
    }
}
