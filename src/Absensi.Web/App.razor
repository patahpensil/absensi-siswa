@using Absensi.Web.Layanan
@using Absensi.Web.Layar
@inject StatusAplikasi Status
@inject NavigationManager Navigasi

@if (Navigasi.Uri.Contains("diagnostik", StringComparison.OrdinalIgnoreCase))
{
    <Diagnostik />
}
else if (!muatSelesai)
{
    <p class="memuat" id="memuat">Menyiapkan aplikasi…</p>
}
else if (Status.PesanGalat is not null)
{
    <p class="galat" id="galat-awal">@Status.PesanGalat</p>
}
else if (Status.NeedsInstallation)
{
    <WizardWeb OnSelesai="StateHasChanged" />
}
else if (Status.Akun is null)
{
    <Masuk OnMasuk="StateHasChanged" />
}
else if (Status.MustChangePassword)
{
    <main class="login-layout">
        <section class="login-form-area">
            <div class="login-card">
                <h1>Buat sandi baru</h1>
                <ChangePassword Forced="true" OnChanged="StateHasChanged" OnLogout="Logout" />
            </div>
        </section>
    </main>
}
else
{
    <Kerangka OnKeluar="StateHasChanged" />
}

@code {
    private bool muatSelesai;

    private void Logout()
    {
        Status.Keluar();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Navigasi.Uri.Contains("diagnostik", StringComparison.OrdinalIgnoreCase))
        {
            await Task.Delay(50);
            await Status.MulaiAsync();
        }

        muatSelesai = true;
    }
}
