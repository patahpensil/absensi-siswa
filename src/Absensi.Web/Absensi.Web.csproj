<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Aplikasi web uji (rencana disepakati pemilik, PROGRES-DAN-UTANG.md §10).
       Tahap pertama: membuktikan Absensi.Data (SQLite + migrasi + Excel) dapat
       berjalan di browser. Teknologi frontend produksi tetap keputusan D-08. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <!-- SQLite adalah pustaka native; di browser ia harus ditautkan ke dalam
         runtime WebAssembly (butuh workload wasm-tools saat publish). -->
    <WasmBuildNative>true</WasmBuildNative>
    <!-- Trimming dimatikan selama pembuktian agar kegagalan tidak bercampur
         dengan kode yang terpangkas diam-diam. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Absensi.Data\Absensi.Data.csproj" />
  </ItemGroup>

</Project>
