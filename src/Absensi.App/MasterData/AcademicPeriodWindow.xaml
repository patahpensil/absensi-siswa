<Window x:Class="Absensi.App.MasterData.AcademicPeriodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tahun ajaran dan kenaikan kelas"
        Height="680" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource KertasBrush}">

    <!-- PRD §16.14: lima tindakan yang sama dengan layar web; seluruh aturan
         diperiksa AcademicPeriodService. -->
    <Border Style="{StaticResource PanelMengambangStyle}" Margin="12">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Visibility="{Binding Message, Converter={StaticResource NullKeVisibilitas}}"
                           Margin="0,8,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PesanSalahKolomStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource HadirTeksBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Tutup" Style="{StaticResource TombolTeksStyle}" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="Simpan" Style="{StaticResource TombolUtamaStyle}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tahun ajaran dan kenaikan kelas" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,16" />

                    <TextBlock Text="Tindakan" Style="{StaticResource LabelKolomStyle}" />
                    <ComboBox ItemsSource="{Binding Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedAction}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />

                    <StackPanel Visibility="{Binding ShowPrepare, Converter={StaticResource BoolKeVisibilitas}}">
                        <TextBlock Text="Tahun ajaran (mis. 2027/2028)" Style="{StaticResource LabelKolomStyle}" />
                        <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                        <TextBlock Text="Semester" Style="{StaticResource LabelKolomStyle}" />
                        <ComboBox ItemsSource="{Binding Semesters}" SelectedItem="{Binding Semester}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />
                        <TextBlock Text="Mulai" Style="{StaticResource LabelKolomStyle}" />
                        <DatePicker SelectedDate="{Binding Start}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />
                        <TextBlock Text="Berakhir" Style="{StaticResource LabelKolomStyle}" />
                        <DatePicker SelectedDate="{Binding End}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,8" />
                        <TextBlock Text="Jadwal mingguan disalin dari periode aktif." Style="{StaticResource TeksUtamaStyle}" Foreground="{StaticResource AbuTulisBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowSource, Converter={StaticResource BoolKeVisibilitas}}">
                        <TextBlock Text="Periode asal" Style="{StaticResource LabelKolomStyle}" />
                        <ComboBox ItemsSource="{Binding Periods}" DisplayMemberPath="Label" SelectedItem="{Binding SourcePeriod}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />
                        <TextBlock Text="Kelas asal" Style="{StaticResource LabelKolomStyle}" />
                        <ComboBox ItemsSource="{Binding SourceClasses}" DisplayMemberPath="Nama" SelectedItem="{Binding SourceClass}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowTargetPeriod, Converter={StaticResource BoolKeVisibilitas}}">
                        <TextBlock Text="Periode tujuan" Style="{StaticResource LabelKolomStyle}" />
                        <ComboBox ItemsSource="{Binding TargetPeriods}" DisplayMemberPath="Label" SelectedItem="{Binding TargetPeriod}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowTargetClass, Converter={StaticResource BoolKeVisibilitas}}">
                        <TextBlock Text="Kelas tujuan" Style="{StaticResource LabelKolomStyle}" />
                        <ComboBox ItemsSource="{Binding TargetClasses}" DisplayMemberPath="Nama" SelectedItem="{Binding TargetClass}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowSource, Converter={StaticResource BoolKeVisibilitas}}">
                        <TextBlock Text="Siswa terpilih" Style="{StaticResource LabelKolomStyle}" />
                        <ItemsControl ItemsSource="{Binding Students}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected}" Margin="0,2">
                                        <TextBlock Style="{StaticResource TeksUtamaStyle}">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Nisn, Mode=OneWay}" Foreground="{StaticResource AbuTulisBrush}" />
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowChangeDates, Converter={StaticResource BoolKeVisibilitas}}">
                        <TextBlock Text="Periode" Style="{StaticResource LabelKolomStyle}" />
                        <ComboBox ItemsSource="{Binding Periods}" DisplayMemberPath="Label" SelectedItem="{Binding EditPeriod}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />
                        <TextBlock Text="Mulai" Style="{StaticResource LabelKolomStyle}" />
                        <DatePicker SelectedDate="{Binding EditStart}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />
                        <TextBlock Text="Berakhir" Style="{StaticResource LabelKolomStyle}" />
                        <DatePicker SelectedDate="{Binding EditEnd}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,8" />
                        <TextBlock Text="Tanggal yang sudah punya catatan absensi harus tetap berada di dalam rentang, dan periode aktif harus tetap mencakup hari ini."
                                   Style="{StaticResource TeksUtamaStyle}" Foreground="{StaticResource AbuTulisBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox Content="{Binding ConfirmText}" IsChecked="{Binding Confirmed}"
                              Visibility="{Binding ShowConfirm, Converter={StaticResource BoolKeVisibilitas}}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
