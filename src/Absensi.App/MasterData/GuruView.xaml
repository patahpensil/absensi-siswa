<UserControl x:Class="Absensi.App.MasterData.GuruView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:koreksi="clr-namespace:Absensi.App.Koreksi">

    <TabControl Margin="{StaticResource PaddingTepiHalaman}">
    <TabItem Header="Data Guru">
    <Grid Margin="16,16,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Guru" Style="{StaticResource JudulHalamanStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Unduh Template" Style="{StaticResource TombolSekunderStyle}" Command="{Binding UnduhTemplateCommand}" Margin="0,0,8,0" />
                    <Button Content="Impor Excel" Style="{StaticResource TombolSekunderStyle}" Command="{Binding ImporExcelCommand}" Margin="0,0,8,0" />
                    <Button Content="Impor foto" Style="{StaticResource TombolSekunderStyle}" Command="{Binding ImporFotoCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="{Binding PesanStatus}" Style="{StaticResource LabelKecilStyle}" Margin="0,0,0,8" />

            <!-- UAT Bug #12 (2026-09-22): sama seperti SiswaView.xaml — lihat
                 komentar di sana untuk akar masalah (bug WPF DataGrid saat
                 View dibuat ulang oleh DataTemplate implisit lintas navigasi
                 menu). MinWidth per kolom di bawah adalah batas bawah keras
                 yang mencegah kolom menyempit/berhimpitan meski pengukuran
                 "*"/pixel sementaranya salah. -->
            <DataGrid x:Name="TabelGuru" Style="{StaticResource TabelStyle}" ItemsSource="{Binding Daftar}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" MinWidth="180" />
                    <DataGridTextColumn Header="NIP" Binding="{Binding Nip}" Width="140" MinWidth="140" />
                    <DataGridTextColumn Header="Kartu" Binding="{Binding PunyaKartu}" Width="70" MinWidth="70" />
                    <DataGridTextColumn Header="TG" Binding="{Binding TertautTelegram}" Width="60" MinWidth="60" />
                    <DataGridTextColumn Header="Status" Binding="{Binding AlasanNonaktif}" Width="100" MinWidth="100" />
                    <DataGridTemplateColumn Header="" Width="290" MinWidth="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ubah" Style="{StaticResource TombolTeksStyle}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Unggah foto" Style="{StaticResource TombolTeksStyle}"
                                            Command="{Binding DataContext.UnggahFotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <!-- PRD §17.10: registrasi/ganti kartu guru hanya TU/Admin/Kepsek — KartuCommand.CanExecute menyembunyikannya untuk wali kelas -->
                                    <Button Content="Kartu" Style="{StaticResource TombolTeksStyle}"
                                            Command="{Binding DataContext.KartuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Nonaktifkan" Style="{StaticResource TombolTeksStyle}"
                                            Command="{Binding DataContext.NonaktifkanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource KartuStyle}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding JudulFormulir}" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,16" />

                <TextBlock Text="NIP" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding Nip, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="Nama" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="Pangkat" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding Pangkat, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="Jabatan" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding Jabatan, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="{Binding PesanGalat}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}"
                           Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Batal" Style="{StaticResource TombolTeksStyle}" Command="{Binding BatalEditCommand}" Margin="0,0,8,0" />
                    <Button Content="Simpan" Style="{StaticResource TombolUtamaStyle}" Command="{Binding SimpanCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </TabItem>

    <TabItem Header="Kehadiran">
        <koreksi:StatusGuruView DataContext="{Binding StatusGuru}" />
    </TabItem>
    </TabControl>
</UserControl>
