<UserControl x:Class="Absensi.App.MasterData.SiswaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Audit UI 2026-09-24 (1366x768 dan 1280x720): formulir tambah/ubah
         dipindah ke dialog (FormSiswaWindow, dibuka lewat "Tambah siswa" dan
         "Ubah") — panel kanan 320 px sebelumnya menyisakan ±730 px untuk tabel
         sehingga kolom aksi terpotong, tabel harus digulir ke samping, dan
         Simpan/Batal berada di bawah lipatan. Tabel kini memakai seluruh lebar. -->
    <Grid Margin="{StaticResource PaddingTepiHalaman}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Siswa" Style="{StaticResource JudulHalamanStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Unduh Template" Style="{StaticResource TombolSekunderStyle}" Command="{Binding UnduhTemplateCommand}" Margin="0,0,8,0" />
                <Button Content="Impor Excel" Style="{StaticResource TombolSekunderStyle}" Command="{Binding ImporExcelCommand}" Margin="0,0,8,0" />
                <Button Content="Tambah siswa" Style="{StaticResource TombolUtamaStyle}" Command="{Binding TambahCommand}" />
            </StackPanel>
        </Grid>

        <!-- Hasil aksi (berhasil/gagal) yang sebenarnya, di luar dialog. -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding PesanStatus}" Style="{StaticResource TeksUtamaStyle}" Foreground="{StaticResource HadirTeksBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding PesanStatus, Converter={StaticResource NullKeVisibilitas}}" />
            <TextBlock Text="{Binding PesanGalat}" Style="{StaticResource PesanSalahKolomStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}" />
        </StackPanel>

        <!-- PRD §14.4: hitungan untuk kelas yang sedang dipilih -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding DaftarKelasFilter}"
                      SelectedItem="{Binding KelasFilterTerpilih}"
                      DisplayMemberPath="Nama"
                      Width="180"
                      Margin="0,0,16,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding RingkasanKelas}"
                       Style="{StaticResource LabelKecilStyle}"
                       VerticalAlignment="Center"
                       Visibility="{Binding RingkasanKelas, Converter={StaticResource NullKeVisibilitas}}" />
        </Grid>

        <!-- UAT Bug #12 (2026-09-22): setelah navigasi antar panel, kolom DataGrid
             menyempit/berhimpitan — MinWidth per kolom di bawah adalah BATAS BAWAH
             KERAS yang ditegakkan terpisah dari perhitungan "*"/pixel WPF.

             UAT 2026-09-23: kolom TG dan Alasan dihapus (TertautTelegram dan
             AlasanNonaktif tetap dipakai modul lain — hanya tampilannya di sini);
             syarat PRD §14.4 "siswa tidak aktif tetap muncul dengan nama redup dan
             alasannya" dipenuhi lewat teks alasan inline di sebelah nama.

             2026-09-24: lebar tetap kolom (105+45+90+115+340) + Nama minimum 170 =
             865 px muat di panel 1280x720 (±990 px) tanpa scroll horizontal. -->
        <DataGrid Grid.Row="3" x:Name="TabelSiswa" Style="{StaticResource TabelStyle}" ItemsSource="{Binding Daftar}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Nama" Width="*" MinWidth="170" SortMemberPath="Nama">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding Nama, Mode=OneWay}" ToolTip="{Binding Nama, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Aktif}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource AbuTulisBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding AlasanNonaktif, StringFormat=' ({0})'}"
                                           Foreground="{StaticResource AbuTulisBrush}"
                                           FontStyle="Italic"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding AlasanNonaktif, Converter={StaticResource NullKeVisibilitas}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="NISN" Binding="{Binding Nisn, Mode=OneWay}" ElementStyle="{StaticResource TeksSelStyle}" Width="105" MinWidth="105" />
                <DataGridTextColumn Header="JK" Binding="{Binding JenisKelamin, Mode=OneWay}" ElementStyle="{StaticResource TeksSelStyle}" Width="45" MinWidth="45" />
                <DataGridTextColumn Header="Kelas" Binding="{Binding KelasNama, Mode=OneWay}" ElementStyle="{StaticResource TeksSelStyle}" Width="90" MinWidth="90" />
                <!-- UAT Bug #11 (2026-09-23): UID sebenarnya lewat KartuUidKeTeksConverter, atau "Belum terdaftar". -->
                <DataGridTextColumn Header="Kartu" Binding="{Binding KartuUid, Mode=OneWay, Converter={StaticResource KartuUidKeTeks}}" ElementStyle="{StaticResource TeksSelStyle}" Width="115" MinWidth="115" />
                <!-- Aksi: empat slot berlebar tetap (tombol sejajar antar baris). "Ganti kartu"
                     hanya bila sudah punya kartu (PRD §16.11 — kartu pertama lewat Registrasi
                     Kartu per kelas §16.5); "Mutasi" hanya untuk siswa aktif. -->
                <DataGridTemplateColumn Header="" Width="340" MinWidth="340">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="102" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Ubah" Style="{StaticResource TombolTeksBarisStyle}"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="1" Content="Unggah foto" Style="{StaticResource TombolTeksBarisStyle}"
                                        Command="{Binding DataContext.UnggahFotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="2" Content="Ganti kartu" Style="{StaticResource TombolTeksBarisStyle}"
                                        Command="{Binding DataContext.GantiKartuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding PunyaKartu, Converter={StaticResource BoolKeVisibilitas}}" />
                                <Button Grid.Column="3" Content="Mutasi" Style="{StaticResource TombolTeksBarisStyle}"
                                        Command="{Binding DataContext.NonaktifkanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding Aktif, Converter={StaticResource BoolKeVisibilitas}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Keadaan kosong: belum ada siswa (atau tidak ada di kelas terpilih). -->
        <TextBlock Grid.Row="3" Text="Belum ada siswa. Klik &quot;Tambah siswa&quot; atau &quot;Impor Excel&quot; untuk mengisi."
                   Foreground="{StaticResource AbuTulisBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TeksUtamaStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Daftar.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
