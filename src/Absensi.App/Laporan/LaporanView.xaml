<UserControl x:Class="Absensi.App.Laporan.LaporanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="{StaticResource PaddingTepiHalaman}">
        <TextBlock DockPanel.Dock="Top" Text="Laporan" Style="{StaticResource JudulHalamanStyle}" Margin="0,0,0,16" />

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding BolehAkses, Converter={StaticResource BoolKeVisibilitas}}">
            <StackPanel Orientation="Vertical" Margin="0,0,16,8">
                <TextBlock Text="Jenis" Style="{StaticResource LabelKolomStyle}" />
                <ComboBox ItemsSource="{Binding DaftarJenis}" DisplayMemberPath="Label" SelectedValuePath="Nilai"
                          SelectedValue="{Binding JenisTerpilih}" Width="140" Height="{StaticResource TinggiKontrol}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,16,8">
                <TextBlock Text="Subjek" Style="{StaticResource LabelKolomStyle}" />
                <ComboBox ItemsSource="{Binding DaftarSubjek}" DisplayMemberPath="Label" SelectedValuePath="Nilai"
                          SelectedValue="{Binding SubjekTerpilih}" Width="100" Height="{StaticResource TinggiKontrol}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,16,8" Visibility="{Binding TampilkanKelas, Converter={StaticResource BoolKeVisibilitas}}">
                <TextBlock Text="Kelas" Style="{StaticResource LabelKolomStyle}" />
                <ComboBox ItemsSource="{Binding DaftarKelas}" DisplayMemberPath="Nama" SelectedValuePath="Id"
                          SelectedValue="{Binding KelasTerpilihId}" Width="140" Height="{StaticResource TinggiKontrol}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,16,8" Visibility="{Binding TampilkanTanggal, Converter={StaticResource BoolKeVisibilitas}}">
                <TextBlock Text="Tanggal" Style="{StaticResource LabelKolomStyle}" />
                <DatePicker SelectedDate="{Binding TanggalAwal}" Height="{StaticResource TinggiKontrol}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,16,8" Visibility="{Binding TampilkanTanggalAkhir, Converter={StaticResource BoolKeVisibilitas}}">
                <TextBlock Text="Sampai" Style="{StaticResource LabelKolomStyle}" />
                <DatePicker SelectedDate="{Binding TanggalAkhir}" Height="{StaticResource TinggiKontrol}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,16,8" Visibility="{Binding TampilkanCetakSatuOrang, Converter={StaticResource BoolKeVisibilitas}}">
                <TextBlock Text=" " Style="{StaticResource LabelKolomStyle}" />
                <CheckBox Content="Cetak satu orang" IsChecked="{Binding CetakSatuOrang}" VerticalAlignment="Center" Height="{StaticResource TinggiKontrol}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,16,8" Visibility="{Binding TampilkanOrang, Converter={StaticResource BoolKeVisibilitas}}">
                <TextBlock Text="Orang" Style="{StaticResource LabelKolomStyle}" />
                <ComboBox ItemsSource="{Binding DaftarOrang}" DisplayMemberPath="Nama" SelectedValuePath="Id"
                          SelectedValue="{Binding OrangTerpilihId}" Width="200" Height="{StaticResource TinggiKontrol}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,8" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Ekspor Excel" Style="{StaticResource TombolSekunderStyle}" Command="{Binding EksporExcelCommand}" Margin="0,0,8,0" />
                    <Button Content="Ekspor PDF" Style="{StaticResource TombolUtamaStyle}" Command="{Binding EksporPdfCommand}" />
                </StackPanel>
            </StackPanel>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding PesanGalat}" Style="{StaticResource PesanSalahKolomStyle}"
                   Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding PesanStatus}" Style="{StaticResource TeksUtamaStyle}"
                   Foreground="{StaticResource HadirTeksBrush}"
                   Visibility="{Binding PesanStatus, Converter={StaticResource NullKeVisibilitas}}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid Visibility="{Binding BolehAkses, Converter={StaticResource BoolKeVisibilitas}}">
        <!-- Pratinjau Harian/Mingguan (PRD §11, §11.1) -->
        <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding PratinjauKejadian}"
                  Visibility="{Binding TampilkanPratinjauKejadian, Converter={StaticResource BoolKeVisibilitas}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat=dd/MM/yyyy}" Width="90" />
                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" />
                <DataGridTextColumn Header="Identitas" Binding="{Binding Identitas}" Width="110" />
                <DataGridTextColumn Header="Kelas" Binding="{Binding Kelas}" Width="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusHuruf}" Width="60" />
                <DataGridTextColumn Header="Jam masuk" Binding="{Binding JamMasuk}" Width="80" />
                <DataGridTextColumn Header="Jam pulang" Binding="{Binding JamPulang}" Width="80" />
                <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pratinjau Bulanan (PRD §11.2) — kolom tanggal dinamis, jadi apa adanya lewat AutoGenerateColumns. -->
        <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding PratinjauBulanan}" AutoGenerateColumns="True"
                  Visibility="{Binding TampilkanPratinjauBulanan, Converter={StaticResource BoolKeVisibilitas}}" />

        <!-- Pratinjau Semester (PRD §11.4) dan Per Orang sekaligus satu kelas/seluruh guru (PRD §11.3/§17.8) -->
        <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding PratinjauSemester}"
                  Visibility="{Binding TampilkanPratinjauSemester, Converter={StaticResource BoolKeVisibilitas}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" />
                <DataGridTextColumn Header="Identitas" Binding="{Binding Identitas}" Width="110" />
                <DataGridTextColumn Header="Kelas" Binding="{Binding Kelas}" Width="70" />
                <DataGridTextColumn Header="Hadir" Binding="{Binding Rekap.Hadir}" Width="55" />
                <DataGridTextColumn Header="Sakit" Binding="{Binding Rekap.Sakit}" Width="55" />
                <DataGridTextColumn Header="Izin" Binding="{Binding Rekap.Izin}" Width="55" />
                <DataGridTextColumn Header="Alpa" Binding="{Binding Rekap.Alpa}" Width="55" />
                <DataGridTextColumn Header="Terlambat" Binding="{Binding Rekap.Terlambat}" Width="70" />
                <DataGridTextColumn Header="Bolos" Binding="{Binding Rekap.Bolos}" Width="55" />
                <DataGridTextColumn Header="Tidak lengkap" Binding="{Binding Rekap.TidakLengkap}" Width="90" />
                <DataGridTextColumn Header="Dinas luar" Binding="{Binding Rekap.DinasLuar}" Width="70" />
                <DataGridTextColumn Header="Cuti" Binding="{Binding Rekap.Cuti}" Width="55" />
                <DataGridTextColumn Header="% Kehadiran" Binding="{Binding Rekap.Persentase, StringFormat={}{0:0.0}%}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pratinjau kartu satu orang (PRD §11.3/§17.8) -->
        <Border Style="{StaticResource KartuStyle}" VerticalAlignment="Top"
                Visibility="{Binding TampilkanPratinjauOrang, Converter={StaticResource BoolKeVisibilitas}}">
            <StackPanel>
                <TextBlock Text="{Binding KartuTerpilih.Nama, TargetNullValue='Pilih orang untuk melihat pratinjau'}" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding KartuTerpilih.Identitas, StringFormat='Identitas: {0}'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding KartuTerpilih.Kelas, StringFormat='Kelas: {0}'}" Margin="0,0,0,8"
                           Visibility="{Binding KartuTerpilih.Kelas, Converter={StaticResource NullKeVisibilitas}}" />
                <TextBlock Margin="0,0,0,16">
                    <Run Text="Hadir" /><Run Text="{Binding KartuTerpilih.Rekap.Hadir}" />
                    <Run Text=" · Sakit" /><Run Text="{Binding KartuTerpilih.Rekap.Sakit}" />
                    <Run Text=" · Izin" /><Run Text="{Binding KartuTerpilih.Rekap.Izin}" />
                    <Run Text=" · Alpa" /><Run Text="{Binding KartuTerpilih.Rekap.Alpa}" />
                    <Run Text=" · Terlambat" /><Run Text="{Binding KartuTerpilih.Rekap.Terlambat}" />
                    <Run Text=" · Bolos" /><Run Text="{Binding KartuTerpilih.Rekap.Bolos}" />
                    <Run Text=" · Tidak lengkap" /><Run Text="{Binding KartuTerpilih.Rekap.TidakLengkap}" />
                    <Run Text=" · Dinas luar" /><Run Text="{Binding KartuTerpilih.Rekap.DinasLuar}" />
                    <Run Text=" · Cuti" /><Run Text="{Binding KartuTerpilih.Rekap.Cuti}" />
                    <LineBreak />
                    <Run Text="Kehadiran " /><Run Text="{Binding KartuTerpilih.Rekap.Persentase, StringFormat={}{0:0.0}%}" />
                    <Run Text=" dari " /><Run Text="{Binding KartuTerpilih.Rekap.HariEfektif}" /><Run Text=" hari efektif" />
                </TextBlock>

                <TextBlock Text="Rincian hari tidak hadir dan terlambat" Style="{StaticResource LabelKolomStyle}" Margin="0,0,0,4" />
                <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding KartuTerpilih.Rincian}" Height="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat=dd/MM/yyyy}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusHuruf}" Width="70" />
                        <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        </Grid>
    </DockPanel>
</UserControl>
