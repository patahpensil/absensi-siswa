<UserControl x:Class="Absensi.App.Kalender.KalenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="{StaticResource PaddingTepiHalaman}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Kalender" Style="{StaticResource JudulHalamanStyle}" Margin="0,0,0,16" />

            <!-- PRD §6: "tampilan bulanan, blok tanggal libur" — pewarnaan
                 sel lewat CalendarDayButtonStyle, bukan BlackoutDates
                 (lihat KalenderViewModel). -->
            <Calendar x:Name="KalenderKontrol"
                      DockPanel.Dock="Top"
                      SelectionMode="MultipleRange"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,16"
                      SelectedDatesChanged="KalenderKontrol_SelectedDatesChanged"
                      DisplayDateChanged="KalenderKontrol_DisplayDateChanged">
                <Calendar.CalendarDayButtonStyle>
                    <Style TargetType="CalendarDayButton">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Value="True">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource TanggalLiburKeBool}">
                                                <Binding />
                                                <Binding Path="DataContext.TanggalLibur" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource AlpaDitolakLatarBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AlpaDitolakTeksBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AlpaDitolakGarisBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Calendar.CalendarDayButtonStyle>
            </Calendar>

            <TextBlock DockPanel.Dock="Top" Text="Tanggal ditandai bulan ini" Style="{StaticResource LabelKolomStyle}" Margin="0,0,0,4" />
            <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding DaftarBulanIni}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat=d MMMM yyyy}" Width="160" />
                    <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="100" />
                    <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource KartuStyle}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Tandai Tanggal" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,16" />

                <TextBlock Text="Tanggal terpilih" Style="{StaticResource LabelKolomStyle}" />
                <TextBlock Text="{Binding RentangTeks, TargetNullValue='Belum ada tanggal dipilih — klik atau seret pada kalender'}"
                           Style="{StaticResource TeksUtamaStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <TextBlock Text="Keterangan" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}"
                         Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="80"
                         Margin="0,0,0,4" />
                <TextBlock Text="Wajib diisi untuk menandai libur"
                           Style="{StaticResource LabelKecilStyle}"
                           Foreground="{StaticResource AbuTulisBrush}"
                           Margin="0,0,0,16" />

                <TextBlock Text="{Binding PesanGalat}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding PesanStatus}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource HadirTeksBrush}"
                           Visibility="{Binding PesanStatus, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <Button Content="Tandai Libur" Style="{StaticResource TombolBahayaStyle}" Command="{Binding TandaiLiburCommand}" Margin="0,0,0,8" />
                <Button Content="Tandai Hari Sekolah" Style="{StaticResource TombolSekunderStyle}" Command="{Binding TandaiSekolahCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
