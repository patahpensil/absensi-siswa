<UserControl x:Class="Absensi.App.Pengaturan.PengaturanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pengaturan="clr-namespace:Absensi.App.Pengaturan">

    <DockPanel Margin="{StaticResource PaddingTepiHalaman}">
        <TextBlock DockPanel.Dock="Top" Text="Pengaturan" Style="{StaticResource JudulHalamanStyle}" Margin="0,0,0,16" />

        <!-- RENCANA-TUGAS.md Tugas 14: sub-tab "Akun" ditambahkan di sini.
             Disembunyikan sepenuhnya untuk wali kelas (bukan hanya tombol
             di dalamnya) — PRD §3: "tidak bisa akses menu ini sama sekali". -->
        <TabControl>
        <TabItem Header="Umum">
    <StackPanel Margin="16,16,0,0">
        <!-- PRD §16.6 langkah 2: "Admin memasukkan token bot dan username
             bot di menu Pengaturan" (Tugas 10). Identitas sekolah/tahun
             ajaran/backup menunggu Tugas masing-masing. -->
        <Border Style="{StaticResource KartuStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Bot Telegram" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Sekolah membuat bot sendiri lewat BotFather (PRD §16.6). Username tanpa tanda @."
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource AbuTulisBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <TextBlock Text="Token bot" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding TokenBot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="Username bot" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding UsernameBot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="{Binding PesanStatusBot}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource HadirTeksBrush}"
                           Visibility="{Binding PesanStatusBot, Converter={StaticResource NullKeVisibilitas}}"
                           Margin="0,0,0,8" />

                <Button Content="Simpan Bot Telegram"
                        Style="{StaticResource TombolUtamaStyle}"
                        Command="{Binding SimpanBotCommand}"
                        HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource KartuStyle}" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="Jadwal Harian" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Seluruh nilai adalah konfigurasi per sekolah, bukan nilai tetap (PRD §7). Kosongkan jam untuk hari yang bukan hari sekolah."
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource AbuTulisBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding JadwalHarian}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hari" Binding="{Binding NamaHari}" Width="110" IsReadOnly="True" />
                        <DataGridCheckBoxColumn Header="Hari sekolah" Binding="{Binding HariSekolah, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Jam masuk" Binding="{Binding JamMasuk, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Jam rekap" Binding="{Binding JamRekap, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Batas akhir tap masuk" Binding="{Binding BatasTapMasuk, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                        <DataGridTextColumn Header="Mulai absen pulang" Binding="{Binding MulaiPulang, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding PesanGalat}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <TextBlock Text="{Binding PesanStatus}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource HadirTeksBrush}"
                           Visibility="{Binding PesanStatus, Converter={StaticResource NullKeVisibilitas}}"
                           Margin="0,8,0,0" />

                <Button Content="Simpan Jadwal Harian"
                        Style="{StaticResource TombolUtamaStyle}"
                        Command="{Binding SimpanJadwalCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- RENCANA-TUGAS.md Tugas 13 — PRD §18: dua titik backup otomatis
             (pembukaan aplikasi, batas akhir tap masuk) berjalan sendiri di
             latar belakang; di sini hanya daftar berkas lokal + restore. -->
        <Border Style="{StaticResource KartuStyle}" HorizontalAlignment="Stretch" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Backup" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Backup berjalan otomatis setiap aplikasi dibuka dan setelah batas akhir tap masuk (PRD §18.1). Tujuh berkas terakhir disimpan di folder backup/."
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource AbuTulisBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding DaftarBackup}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Berkas" Binding="{Binding NamaBerkas}" Width="200" />
                        <DataGridTextColumn Header="Dibuat" Binding="{Binding WaktuDibuat}" Width="160" />
                        <DataGridTextColumn Header="Hari data hilang jika dipulihkan" Binding="{Binding HariDataHilang}" Width="200" />
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Pulihkan"
                                            Style="{StaticResource TombolSekunderStyle}"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Left" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
        </TabItem>

        <TabItem Header="Akun" Visibility="{Binding Akun.BolehAkses, Converter={StaticResource BoolKeVisibilitas}}">
            <pengaturan:AkunView DataContext="{Binding Akun}" />
        </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
