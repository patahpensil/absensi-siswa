<Window x:Class="Absensi.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleJendela}"
        Height="768" Width="1366"
        MinHeight="720" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Icon="{Binding Logo}"
        Background="{StaticResource KertasBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: nama sekolah, logo, tahun ajaran aktif (PRD §14.2) -->
        <Border Grid.Row="0" Style="{StaticResource HeaderJendelaStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="32" Height="32"
                         Fill="{StaticResource PutihBrush}"
                         VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding NamaSekolah}"
                           Style="{StaticResource JudulHeaderStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />

                <TextBlock Grid.Column="2"
                           Text="{Binding TahunAjaranAktif}"
                           Style="{StaticResource LabelHeaderStyle}"
                           VerticalAlignment="Center" />

                <!-- Penanda akun yang sedang masuk (mis. "Admin · admin1").
                     Kolom Auto TERSENDIRI (bukan berbagi kolom TahunAjaranAktif
                     atau kolom "*" NamaSekolah) supaya lebarnya selalu
                     menyesuaikan teksnya sendiri (tidak pernah terpotong di
                     jendela kecil) TANPA mendorong tombol Keluar, yang tetap
                     kolom Auto TERAKHIR, posisinya rapat ke tepi kanan
                     berapa pun panjang teks penanda ini. -->
                <TextBlock Grid.Column="3"
                           Text="{Binding AkunAktifTeks}"
                           Style="{StaticResource LabelHeaderStyle}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />

                <!-- Tugas 14: App.xaml ShutdownMode="OnExplicitShutdown" —
                     tombol ini satu-satunya jalur menu untuk keluar (jendela
                     ini juga menutup aplikasi bila ditutup lewat tombol X,
                     lihat MainWindow.xaml.cs). -->
                <Button Grid.Column="4"
                        Content="Keluar"
                        Style="{StaticResource TombolTeksStyle}"
                        Foreground="{StaticResource PutihBrush}"
                        Command="{Binding KeluarCommand}"
                        Margin="16,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Style="{StaticResource MenuSampingStyle}"
                     ItemsSource="{Binding MenuItems}"
                     SelectedItem="{Binding MenuAktif, Mode=TwoWay}" />

            <Grid Grid.Column="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding TampilkanPlaceholder, Converter={StaticResource BoolKeVisibilitas}}">
                    <TextBlock Text="{Binding PesanKonten}"
                               Style="{StaticResource TeksUtamaStyle}"
                               Foreground="{StaticResource AbuTulisBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="{Binding TampilkanTombolAbsensi, Converter={StaticResource BoolKeVisibilitas}}">
                        <!-- PRD §14.3: "Tombol | Buka layar gerbang · Registrasi" -->
                        <Button Content="Buka layar gerbang"
                                Style="{StaticResource TombolUtamaStyle}"
                                Command="{Binding BukaGerbangCommand}"
                                Margin="0,0,8,0" />

                        <Button Content="Registrasi"
                                Style="{StaticResource TombolSekunderStyle}"
                                Command="{Binding BukaRegistrasiKartuCommand}" />
                    </StackPanel>
                </StackPanel>

                <ContentControl Content="{Binding KontenAktif}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
