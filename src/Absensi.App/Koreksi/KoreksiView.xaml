<UserControl x:Class="Absensi.App.Koreksi.KoreksiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="{StaticResource PaddingTepiHalaman}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Koreksi" Style="{StaticResource JudulHalamanStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DaftarKelas}" SelectedItem="{Binding KelasTerpilih}"
                          DisplayMemberPath="Nama" Width="160" Height="{StaticResource TinggiKontrol}" HorizontalAlignment="Left" Margin="0,0,16,0" />
                <DatePicker Grid.Column="2" SelectedDate="{Binding TanggalTerpilih}" Height="{StaticResource TinggiKontrol}" Margin="0,0,16,0" />
                <Button Grid.Column="3" Content="Kunci Bulan Ini" Style="{StaticResource TombolBahayaStyle}" Command="{Binding KunciBulanCommand}" />
            </Grid>

            <TextBlock DockPanel.Dock="Top"
                       Text="Bulan ini sudah terkunci — koreksi tidak dapat disimpan (PRD §10)."
                       Style="{StaticResource PesanSalahKolomStyle}"
                       Visibility="{Binding BulanTerkunci, Converter={StaticResource BoolKeVisibilitas}}"
                       Margin="0,0,0,8" />

            <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding Daftar}" SelectedItem="{Binding SiswaTerpilih}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NISN" Binding="{Binding Nisn}" Width="110" />
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="Jam Masuk" Binding="{Binding JamMasuk}" Width="90" />
                    <DataGridTextColumn Header="Jam Pulang" Binding="{Binding JamPulang}" Width="90" />
                    <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource KartuStyle}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding SiswaTerpilih.Nama, TargetNullValue='Pilih siswa dari daftar'}" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,16" />

                <TextBlock Text="Status baru" Style="{StaticResource LabelKolomStyle}" />
                <ComboBox ItemsSource="{Binding DaftarStatus}" SelectedItem="{Binding StatusBaru}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />

                <TextBlock Text="Keterangan" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,0,0,16" />

                <StackPanel Visibility="{Binding TampilkanAtasPermintaan, Converter={StaticResource BoolKeVisibilitas}}">
                    <TextBlock Text="Atas permintaan (wali kelas)" Style="{StaticResource LabelKolomStyle}" />
                    <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding AtasPermintaan, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                </StackPanel>

                <TextBlock Text="{Binding PesanGalat}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding PesanStatus}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource HadirTeksBrush}"
                           Visibility="{Binding PesanStatus, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <Button Content="Simpan Koreksi" Style="{StaticResource TombolUtamaStyle}" Command="{Binding SimpanCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
