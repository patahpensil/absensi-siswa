<UserControl x:Class="Absensi.App.Koreksi.StatusGuruView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="Tanggal" Style="{StaticResource LabelKolomStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding TanggalTerpilih}" Height="{StaticResource TinggiKontrol}" HorizontalAlignment="Left" />
            </DockPanel>

            <TextBlock DockPanel.Dock="Top"
                       Text="Anda tidak berwenang menetapkan status kehadiran guru (PRD §17.10) — hanya Kepala Sekolah."
                       Style="{StaticResource PesanSalahKolomStyle}"
                       Visibility="{Binding TidakBolehMengubah, Converter={StaticResource BoolKeVisibilitas}}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <TextBlock DockPanel.Dock="Top"
                       Text="Bulan ini sudah terkunci."
                       Style="{StaticResource PesanSalahKolomStyle}"
                       Visibility="{Binding BulanTerkunci, Converter={StaticResource BoolKeVisibilitas}}"
                       Margin="0,0,0,8" />

            <DataGrid Style="{StaticResource TabelStyle}" ItemsSource="{Binding Daftar}" SelectedItem="{Binding GuruTerpilih}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NIP" Binding="{Binding Nip}" Width="110" />
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource KartuStyle}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding GuruTerpilih.Nama, TargetNullValue='Pilih guru dari daftar'}" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,16" />

                <TextBlock Text="Status" Style="{StaticResource LabelKolomStyle}" />
                <ComboBox ItemsSource="{Binding DaftarStatus}" SelectedItem="{Binding StatusBaru}" Height="{StaticResource TinggiKontrol}" Margin="0,0,0,16" />

                <TextBlock Text="Keterangan" Style="{StaticResource LabelKolomStyle}" />
                <TextBox Style="{StaticResource KolomTeksStyle}" Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,0,0,16" />

                <TextBlock Text="{Binding PesanStatus}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource HadirTeksBrush}"
                           Visibility="{Binding PesanStatus, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <Button Content="Simpan" Style="{StaticResource TombolUtamaStyle}" Command="{Binding SimpanCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
