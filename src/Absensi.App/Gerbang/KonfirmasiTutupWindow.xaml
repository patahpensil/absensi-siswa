<Window x:Class="Absensi.App.Gerbang.KonfirmasiTutupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Absensi.App.Converters"
        Title="Tutup layar gerbang"
        Width="480"
        SizeToContent="Height"
        MinHeight="320"
        MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{StaticResource KertasBrush}">

    <!-- UAT 2026-09-22: Height fixa 320 lebih kecil dari konten sungguhan
         (judul + deskripsi + 2 kolom + pesan galat + baris tombol), jadi
         baris tombol "Batal"/"Tutup layar gerbang" TERPOTONG di luar area
         jendela pada kombinasi font/DPI tertentu — bukan kosong tanpa teks,
         tombolnya memang ada tapi tidak pernah ter-render di area yang
         terlihat. SizeToContent="Height" membuat jendela selalu menyesuaikan
         tinggi konten sungguhan (termasuk saat PesanGalat muncul dan
         menambah tinggi), jadi tombol dan pesan validasi selalu terlihat
         di 1366x768 maupun skala DPI 100-150% tanpa bergantung metrik
         font yang dipakai saat render. -->
    <Window.Resources>
        <conv:NullKeVisibilitasConverter x:Key="NullKeVisibilitas" />
    </Window.Resources>

    <Border Style="{StaticResource PanelMengambangStyle}" Margin="12">
        <StackPanel>
            <TextBlock Text="Tutup layar gerbang?" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Masukkan username dan sandi akun untuk menutup layar ini."
                       Style="{StaticResource TeksUtamaStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <TextBlock Text="Username" Style="{StaticResource LabelKolomStyle}" />
            <TextBox x:Name="KolomUsername"
                     Style="{StaticResource KolomTeksStyle}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16" />

            <TextBlock Text="Sandi" Style="{StaticResource LabelKolomStyle}" />
            <PasswordBox x:Name="KolomSandi"
                         Style="{StaticResource KolomSandiStyle}"
                         PasswordChanged="KolomSandi_PasswordChanged"
                         Margin="0,0,0,8" />

            <TextBlock Text="{Binding PesanGalat}"
                       Style="{StaticResource PesanSalahKolomStyle}"
                       Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}"
                       Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Batal"
                        Style="{StaticResource TombolTeksStyle}"
                        Click="TombolBatal_Click"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button Content="Tutup layar gerbang"
                        Style="{StaticResource TombolUtamaStyle}"
                        Command="{Binding KonfirmasiCommand}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
