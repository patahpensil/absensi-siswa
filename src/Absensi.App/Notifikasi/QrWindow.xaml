<Window x:Class="Absensi.App.Notifikasi.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR Pairing"
        Height="420" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{StaticResource KertasBrush}">

    <Border Style="{StaticResource PanelMengambangStyle}" Margin="12">
        <StackPanel HorizontalAlignment="Center">
            <StackPanel x:Name="PanelCetak" HorizontalAlignment="Center" Background="{StaticResource PutihBrush}">
                <TextBlock Text="{Binding Nama}" Style="{StaticResource JudulBagianStyle}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="{Binding NisnAtauNip}" Style="{StaticResource TeksUtamaStyle}" Foreground="{StaticResource AbuTulisBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <Image Source="{Binding GambarQr}" Width="240" Height="240" />
            </StackPanel>

            <TextBlock Text="Pindai dengan kamera Telegram untuk tertaut" Style="{StaticResource LabelKecilStyle}" HorizontalAlignment="Center" Margin="0,16,0,16" TextWrapping="Wrap" TextAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Tutup" Style="{StaticResource TombolTeksStyle}" Click="TombolTutup_Click" Margin="0,0,8,0" />
                <Button Content="Cetak" Style="{StaticResource TombolUtamaStyle}" Click="TombolCetak_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
