<Window x:Class="Absensi.App.RegistrasiKartu.TapKartuTunggalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Judul}"
        Height="280" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{StaticResource KertasBrush}">

    <Grid>
        <Border Style="{StaticResource PanelMengambangStyle}" Margin="12">
            <StackPanel>
                <TextBlock Text="{Binding Judul}" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Instruksi}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource AbuTulisBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <TextBlock Text="{Binding PesanGalat}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Batal" Style="{StaticResource TombolTeksStyle}" Click="TombolBatal_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Penangkap masukan reader (USB keyboard-emulation): selalu fokus, tak terlihat -->
        <TextBox x:Name="KolomTap"
                 Width="1" Height="1"
                 Opacity="0"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="Transparent"
                 CaretBrush="Transparent"
                 PreviewKeyDown="KolomTap_PreviewKeyDown"
                 LostFocus="KolomTap_LostFocus" />
    </Grid>
</Window>
