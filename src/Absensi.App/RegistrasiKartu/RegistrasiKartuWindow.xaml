<Window x:Class="Absensi.App.RegistrasiKartu.RegistrasiKartuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrasi Kartu"
        Width="560"
        SizeToContent="Height"
        MinHeight="480"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{StaticResource KertasBrush}">

    <!-- UAT Bug #11 (2026-09-22): Height tetap diganti SizeToContent="Height"
         supaya pesan-pesan dinamis tidak berisiko terpotong seperti bug
         KonfirmasiTutupWindow (Layar Gerbang, 2026-09-22).

         UAT Bug #11 (2026-09-23, REDESAIN FUNDAMENTAL): alur antrean
         otomatis lama (kursor lompat sendiri ke siswa berikutnya) diganti
         alur eksplisit satu-siswa-satu-kartu — lihat komentar di
         RegistrasiKartuViewModel.cs untuk detail lengkap dan PRD §16.5
         (direvisi) untuk keputusan produk. -->
    <Grid>
        <Border Style="{StaticResource PanelMengambangStyle}" Margin="12">
            <StackPanel>
                <TextBlock Text="Registrasi Kartu" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Selama registrasi berlangsung, tap kartu tidak dicatat sebagai absensi."
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource AbuTulisBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <TextBlock Text="Kelas" Style="{StaticResource LabelKolomStyle}" />
                <ComboBox x:Name="KolomKelas"
                          ItemsSource="{Binding DaftarKelas}"
                          SelectedItem="{Binding KelasTerpilih, Mode=TwoWay}"
                          DisplayMemberPath="Nama"
                          Height="{StaticResource TinggiKontrol}"
                          Margin="0,0,0,8" />

                <TextBlock Text="Tahun ajaran aktif ini belum mempunyai kelas. Tambahkan kelas dulu di menu Kelas."
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding TahunAjaranTanpaKelas, Converter={StaticResource BoolKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding PesanMuatKelasGagal}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanMuatKelasGagal, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- UAT 2026-09-23: dropdown BARU — admin memilih SATU siswa
                     secara eksplisit, menggantikan kursor otomatis. -->
                <TextBlock Text="Nama siswa" Style="{StaticResource LabelKolomStyle}" />
                <ComboBox x:Name="KolomSiswa"
                          ItemsSource="{Binding DaftarSiswaKelas}"
                          SelectedItem="{Binding SiswaTerpilih, Mode=TwoWay}"
                          DisplayMemberPath="Nama"
                          Height="{StaticResource TinggiKontrol}"
                          Margin="0,0,0,8" />

                <TextBlock Text="Kelas ini belum punya siswa aktif."
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding KelasBelumPunyaSiswa, Converter={StaticResource BoolKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- "Siswa sekarang": nama, NISN, kelas, status kartu siswa
                     TERPILIH (bukan lagi "siswa berikutnya yang belum
                     terdaftar" — itu konsep antrean lama). -->
                <Border Background="{StaticResource BiruMudaBrush}"
                        CornerRadius="{StaticResource RadiusSedang}"
                        Padding="16"
                        Margin="0,0,0,16"
                        Visibility="{Binding SiswaTerpilih, Converter={StaticResource NullKeVisibilitas}}">
                    <StackPanel>
                        <TextBlock Text="Siswa sekarang" Style="{StaticResource LabelKolomStyle}" />
                        <TextBlock Text="{Binding SiswaTerpilih.Nama}" Style="{StaticResource JudulBagianStyle}" />
                        <TextBlock Text="{Binding SiswaTerpilih.Nisn}" Style="{StaticResource TeksUtamaStyle}" />
                        <TextBlock Text="{Binding SiswaTerpilih.KelasNama}" Style="{StaticResource TeksUtamaStyle}" />
                        <TextBlock Style="{StaticResource TeksUtamaStyle}" Margin="0,8,0,0">
                            <Run Text="Status kartu: " FontWeight="SemiBold" />
                            <Run Text="{Binding StatusKartuSiswaTerpilih, Mode=OneWay}" />
                        </TextBlock>

                        <!-- UID sementara — data BELUM tersimpan, hanya
                             hasil tap yang menunggu Simpan ditekan. -->
                        <TextBlock Text="{Binding UidSementara, StringFormat='Kartu terdeteksi: {0} (belum disimpan)'}"
                                   Style="{StaticResource TeksUtamaStyle}"
                                   Foreground="{StaticResource TerlambatTeksBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding UidSementara, Converter={StaticResource NullKeVisibilitas}}"
                                   Margin="0,8,0,0" />

                        <TextBlock Text="Tempelkan kartu pada reader untuk mendaftarkan siswa ini"
                                   Style="{StaticResource LabelKecilStyle}"
                                   Foreground="{StaticResource AbuTulisBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding PesanGalat}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- Hanya tampil SETELAH transaksi commit dan diverifikasi
                     ulang (RegistrasiKartuViewModel.Simpan) — bukan
                     langsung setelah tap. -->
                <TextBlock Text="{Binding PesanStatus}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource HadirTeksBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding PesanStatus, Converter={StaticResource NullKeVisibilitas}}"
                           Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Batal" Style="{StaticResource TombolTeksStyle}" Click="TombolBatal_Click" Margin="0,0,8,0" />
                    <Button x:Name="TombolSimpan" Content="Simpan" Style="{StaticResource TombolUtamaStyle}" Command="{Binding SimpanCommand}" Click="TombolSimpan_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Penangkap masukan reader (USB keyboard-emulation): selalu fokus, tak terlihat -->
        <TextBox x:Name="KolomTap"
                 Width="1" Height="1"
                 Opacity="0"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="Transparent"
                 CaretBrush="Transparent"
                 PreviewKeyDown="KolomTap_PreviewKeyDown"
                 LostFocus="KolomTap_LostFocus" />
    </Grid>
</Window>
