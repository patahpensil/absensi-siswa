<Window x:Class="Absensi.App.RegistrasiKartu.RegistrasiKartuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrasi Kartu"
        Width="560"
        SizeToContent="Height"
        MinHeight="480"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{StaticResource KertasBrush}">

    <!-- UAT Bug #11 (2026-09-22): Height tetap diganti SizeToContent="Height"
         supaya 2 pesan baru (empty-state kelas kosong / gagal muat) tidak
         berisiko terpotong seperti bug KonfirmasiTutupWindow (Layar Gerbang,
         2026-09-22) — lihat komentar di berkas itu untuk akar masalah yang
         sama persis (Height tetap lebih kecil dari konten sungguhan). -->
    <Grid>
        <Border Style="{StaticResource PanelMengambangStyle}" Margin="12">
            <StackPanel>
                <TextBlock Text="Registrasi Kartu" Style="{StaticResource JudulBagianStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Selama registrasi berlangsung, tap kartu tidak dicatat sebagai absensi."
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource AbuTulisBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <TextBlock Text="Kelas" Style="{StaticResource LabelKolomStyle}" />
                <!-- UAT 2026-09-23: Mode=TwoWay dieksplisitkan atas permintaan
                     audit (default WPF untuk Selector.SelectedItem memang
                     sudah TwoWay — BindsTwoWayByDefault=true di metadata
                     dependency property-nya — jadi ini tidak mengubah
                     perilaku, hanya menghilangkan keraguan). -->
                <ComboBox x:Name="KolomKelas"
                          ItemsSource="{Binding DaftarKelas}"
                          SelectedItem="{Binding KelasTerpilih, Mode=TwoWay}"
                          DisplayMemberPath="Nama"
                          Height="{StaticResource TinggiKontrol}"
                          Margin="0,0,0,8" />

                <!-- UAT Bug #11: dibedakan dari PesanGalat (dipicu tap) —
                     tampil begitu dialog dibuka kalau tahun ajaran aktif
                     memang belum punya kelas sama sekali. -->
                <TextBlock Text="Tahun ajaran aktif ini belum mempunyai kelas. Tambahkan kelas dulu di menu Kelas."
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding TahunAjaranTanpaKelas, Converter={StaticResource BoolKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- UAT Bug #11: kegagalan QUERY (bukan kelas kosong) —
                     dibedakan supaya operator tahu ini masalah teknis,
                     bukan memang belum ada kelas. -->
                <TextBlock Text="{Binding PesanMuatKelasGagal}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanMuatKelasGagal, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding ProgresTeks}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Margin="0,0,0,16" />

                <Border Background="{StaticResource BiruMudaBrush}"
                        CornerRadius="{StaticResource RadiusSedang}"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Siswa sekarang" Style="{StaticResource LabelKolomStyle}" />

                        <!-- UAT 2026-09-23: dulu satu TextBlock dengan
                             TargetNullValue statis yang salah untuk kelas
                             yang MEMANG belum punya siswa (bukan "sudah
                             terdaftar semua") — dipecah jadi dua blok yang
                             saling eksklusif lewat PesanSiswaKosong/
                             TidakAdaSiswaSekarang (RegistrasiKartuViewModel),
                             supaya kondisi "belum ada siswa" jelas beda
                             dari "seluruh siswa sudah terdaftar". Kelas itu
                             sendiri TETAP ada di dropdown Kelas — hanya
                             kartu "Siswa sekarang" ini yang berubah. -->
                        <StackPanel Visibility="{Binding TidakAdaSiswaSekarang, Converter={StaticResource BoolKeVisibilitas}}">
                            <TextBlock Text="{Binding PesanSiswaKosong}" Style="{StaticResource JudulBagianStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding SiswaSekarang, Converter={StaticResource NullKeVisibilitas}}">
                            <TextBlock Text="{Binding SiswaSekarang.Nama}" Style="{StaticResource JudulBagianStyle}" />
                            <TextBlock Text="{Binding SiswaSekarang.Nisn}" Style="{StaticResource TeksUtamaStyle}" />
                            <TextBlock Text="Tempelkan kartu pada reader untuk mendaftarkan"
                                       Style="{StaticResource LabelKecilStyle}"
                                       Foreground="{StaticResource AbuTulisBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding PesanGalat}"
                           Style="{StaticResource PesanSalahKolomStyle}"
                           Visibility="{Binding PesanGalat, Converter={StaticResource NullKeVisibilitas}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding PesanStatus}"
                           Style="{StaticResource TeksUtamaStyle}"
                           Foreground="{StaticResource HadirTeksBrush}"
                           Visibility="{Binding PesanStatus, Converter={StaticResource NullKeVisibilitas}}"
                           Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Batal" Style="{StaticResource TombolTeksStyle}" Click="TombolBatal_Click" Margin="0,0,8,0" />
                    <Button Content="Simpan" Style="{StaticResource TombolUtamaStyle}" Command="{Binding SimpanCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Penangkap masukan reader (USB keyboard-emulation): selalu fokus, tak terlihat -->
        <TextBox x:Name="KolomTap"
                 Width="1" Height="1"
                 Opacity="0"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="Transparent"
                 CaretBrush="Transparent"
                 PreviewKeyDown="KolomTap_PreviewKeyDown"
                 LostFocus="KolomTap_LostFocus" />
    </Grid>
</Window>
