<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Simulator browser untuk menguji aturan absensi tanpa memasang aplikasi
       desktop. Hanya mereferensikan logika simulator dan Absensi.Domain;
       tidak ada database, jaringan, akun, maupun data sungguhan. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Teks antarmuka sudah berbahasa Indonesia secara eksplisit; data ICU
         tidak diperlukan dan memperkecil ukuran unduhan. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Tanpa salinan .br/.gz agar keluaran publish cukup satu set berkas
         untuk diunggah ke hosting statis. -->
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Absensi.Simulator.Core\Absensi.Simulator.Core.csproj" />
  </ItemGroup>

</Project>
